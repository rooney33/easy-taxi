# 이 파일을 .env.local로 복사한 뒤 값을 채우세요
# PostgreSQL 접속 주소 — 로컬(Homebrew) 또는 Supabase/Neon
DATABASE_URL=postgresql://user:password@localhost:5432/easy_taxi
# 운영자 대시보드(/operator) 인증 키 — 반드시 고유한 값으로 변경
OPERATOR_KEY=change-this-key
# 카카오 developers 앱 키 (developers.kakao.com → 내 애플리케이션)
KAKAO_REST_API_KEY=REST_API_키          # 서버 전용 — 랜드마크/주소 검색
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=JS_키   # 프론트 로드뷰 표시용
